# Copy to .env and adjust. Placeholders only.
DATABASE_URL=postgresql://inventory_user:change_me@localhost:5432/acme_inventory
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-random-32+-char-string
JWT_REFRESH_SECRET=replace-with-another-random-32+-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Optional alert e-mails (SMTP)
SMTP_HOST=smtp.example.com
ALERT_FROM_EMAIL=noreply@example.com

# Compose
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=acme_inventory
