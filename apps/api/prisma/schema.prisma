generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(staff)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockTransactions StockTransaction[]
  refreshTokens     RefreshToken[]
  alertConfig       AlertConfig?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  admin
  staff
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  description   String?
  unit          Unit     @default(pcs)
  price         Decimal? @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2) @map("cost_price")
  categoryId    String?  @map("category_id")
  vendorId      String?  @map("vendor_id")
  minStockLevel Int      @default(0) @map("min_stock_level")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category     Category?    @relation(fields: [categoryId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  inventory         Inventory?
  stockTransactions StockTransaction[]
  alerts            Alert[]

  @@map("products")
}

enum Unit {
  pcs
  kg
  ltr
  box
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?  @map("contact_person")
  phone       String?
  email       String?
  city        String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products          Product[]
  stockTransactions StockTransaction[]

  @@map("vendors")
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique @map("product_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  lastUpdatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model Buyer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  city      String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockTransactions StockTransaction[]

  @@map("buyers")
}

model StockTransaction {
  id              String          @id @default(uuid())
  productId       String          @map("product_id")
  type            TransactionType
  quantity        Int
  vendorId        String?         @map("vendor_id")
  unitPrice       Decimal?        @db.Decimal(12, 2) @map("unit_price")
  buyerName       String?         @map("buyer_name")
  buyerId         String?         @map("buyer_id")
  serialNo        String?         @map("serial_no")
  issuedTo        String?         @map("issued_to")
  transactionDate DateTime        @default(now()) @map("transaction_date")
  notes           String?
  idempotencyKey  String?         @unique @map("idempotency_key")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor? @relation(fields: [vendorId], references: [id])
  buyer   Buyer?  @relation(fields: [buyerId], references: [id])
  user    User    @relation(fields: [createdBy], references: [id])

  @@index([productId, createdAt])
  @@map("stock_transactions")
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRY
}

model Alert {
  id        String    @id @default(uuid())
  type      AlertType
  productId String    @map("product_id")
  message   String
  isRead    Boolean   @default(false) @map("is_read")
  isSent    Boolean   @default(false) @map("is_sent")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, isRead])
  @@map("alerts")
}

model AlertConfig {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  emailEnabled      Boolean  @default(false) @map("email_enabled")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  outOfStockEnabled Boolean  @default(true) @map("out_of_stock_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("alert_configs")
}
